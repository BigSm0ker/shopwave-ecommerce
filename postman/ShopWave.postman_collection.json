{
	"info": {
		"_postman_id": "893c52a0-47de-4752-a56e-8d965e638b97",
		"name": "ShopWave E-commerce - Productos",
		"description": "Colección de pruebas para endpoints de productos (públicos y administrativos) del proyecto ShopWave.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Autenticación",
			"item": [
				{
					"name": "Login Administrador (Basic Auth)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const jwtToken = pm.response.headers.get(\"Authorization\");",
									"if (jwtToken) {",
									"    pm.collectionVariables.set(\"jwtToken\", jwtToken);",
									"    pm.test(\"Token JWT extraído y guardado en variable jwtToken\", function() {",
									"        pm.expect(jwtToken).to.be.a('string').and.not.empty;",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "password",
									"value": "admin",
									"type": "string"
								},
								{
									"key": "username",
									"value": "admin@example.com",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/auth/signin",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"signin"
							]
						},
						"description": "Realiza el login usando Basic Auth con el usuario admin por defecto del proyecto. Guarda el token JWT devuelto en la cabecera 'Authorization' para usarlo en las llamadas de administrador."
					},
					"response": []
				}
			]
		},
