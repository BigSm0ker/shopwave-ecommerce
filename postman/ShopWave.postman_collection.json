		{
			"name": "Productos - Admin",
			"item": [
				{
					"name": "Crear un Producto",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 202 Accepted\", function () {",
									"    pm.response.to.have.status(202);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"if (jsonData && jsonData.id) {",
									"    pm.collectionVariables.set(\"createdProductId\", jsonData.id);",
									"    pm.test(\"ID del producto creado almacenado en variable createdProductId\", function() {",
									"        pm.expect(jsonData.id).to.be.a('number');",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "{{jwtToken}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Camiseta Postman Test\",\n  \"description\": \"Producto creado automáticamente desde una prueba de integración de Postman.\",\n  \"price\": 30000,\n  \"discountedPrice\": 24000,\n  \"discountPersent\": 20,\n  \"quantity\": 40,\n  \"brand\": \"PostmanBrand\",\n  \"color\": \"Rojo\",\n  \"sizes\": [\n    {\n      \"name\": \"M\",\n      \"quantity\": 20\n    },\n    {\n      \"name\": \"L\",\n      \"quantity\": 20\n    }\n  ],\n  \"imageUrl\": \"https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=500\",\n  \"topLevelCategory\": \"Hombre\",\n  \"secondLevelCategory\": \"Ropa\",\n  \"thirdLevelCategory\": \"Camisetas\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/admin/products/",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"admin",
								"products",
								""
							]
						},
						"description": "Crea un producto nuevo. Requiere autenticación de administrador mediante el JWT almacenado en `{{jwtToken}}`."
					},
					"response": []
				},
				{
					"name": "Actualizar un Producto",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"El producto se actualizó con el nuevo título y precio\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.title).to.eql(\"Camiseta Postman Test Modificada\");",
									"    pm.expect(jsonData.price).to.eql(35000);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "{{jwtToken}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Camiseta Postman Test Modificada\",\n  \"description\": \"Descripción modificada en pruebas.\",\n  \"price\": 35000,\n  \"discountedPrice\": 28000,\n  \"discountPersent\": 20,\n  \"quantity\": 50\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/admin/products/{{createdProductId}}/update",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"admin",
								"products",
								"{{createdProductId}}",
								"update"
							]
						},
						"description": "Actualiza la información de un producto existente. Usa la variable `{{createdProductId}}` que se guardó al crear el producto."
					},
					"response": []
				},
				{
					"name": "Eliminar un Producto",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 202 Accepted\", function () {",
									"    pm.response.to.have.status(202);",
									"});",
									"",
									"pm.test(\"La respuesta confirma la eliminación exitosa\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql(true);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "{{jwtToken}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/admin/products/{{createdProductId}}/delete",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"admin",
								"products",
								"{{createdProductId}}",
								"delete"
							]
						},
						"description": "Elimina el producto de prueba creado para mantener limpia la base de datos."
					},
					"response": []
				}
			]
		}
